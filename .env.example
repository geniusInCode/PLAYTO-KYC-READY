# ──────────────────────────────────────────────────────────────────────────────
# Playto KYC Portal — Environment Variables
# Copy this file to .env for local development.
# On Render, set these in the Environment tab of your Web Service dashboard.
# ──────────────────────────────────────────────────────────────────────────────

# Django secret key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here-generate-a-long-random-string

# Set to True ONLY for local development
DEBUG=False

# Comma-separated list of allowed hosts.
# Add your Render URL, e.g.: playto-kyc.onrender.com
# Note: *.onrender.com is automatically allowed in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string.
# Render provides this automatically when you attach a PostgreSQL service.
# Leave blank to use SQLite locally.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
